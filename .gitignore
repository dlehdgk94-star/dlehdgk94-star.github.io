# ── 이미지 원본 백업 (185MB JPG/PNG — WebP만 커밋) ──
images/_original_backup/

# ── 환경변수 / 시크릿 (절대 공개 저장소에 올리면 안 됨) ──
.env
.env.*
*.env
.env.local
.env.production
.env.staging

# ── OS 시스템 파일 ──
.DS_Store
Thumbs.db
desktop.ini

# ── Node.js ──
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── 로그 ──
*.log

# ── Supabase 임시 파일 ──
supabase/.temp/

# ── 작업 중 생긴 임시 파일 (커밋 안 함) ──
*.bak
*.bak[0-9]
*.bak[0-9][0-9]
Claude outputs/

# ── 관리자 페이지 (깃허브에 올리지 않음) ──
# GitHub Pages 는 정적 사이트라 올리는 순간 instarhotel.com/admin.html 로 누구나 접속하고,
# 소스에 적힌 비밀번호가 그대로 보인다. 파일은 이 폴더에 그대로 두고,
# Live Server 로 127.0.0.1:5500/admin.html 에서만 연다.
admin.html
